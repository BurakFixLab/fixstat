    "Close" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapat"
          }
        }
      }
    },
    "Close the lid until the Mac sleeps, then open it again. FixStat detects the closing through the lid (Hall) sensor." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapağı Mac uyuyana kadar kapatın, sonra yeniden açın. FixStat kapanmayı kapak (Hall) sensörü üzerinden algılar."
          }
        }
      }
    },
    "Code meanings come from the repair community, not from Apple, and can differ between models." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod anlamları Apple'dan değil tamirci topluluğundan gelir ve modele göre değişebilir."
          }
        }
      }
    },
