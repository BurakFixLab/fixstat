          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameranın yanındaki sensörü parmağınızla kapatın."
          }
        }
      }
    },
    "Covering the sensor does not lower the value: it reads bright all the time (display always bright, keyboard light stays off)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensörü kapatmak değeri düşürmüyor: sürekli aydınlık okuyor (ekran hep parlak, klavye ışığı yanmıyor)."
          }
        }
      }
    },
    "Created with FixStat %@ — github.com/BurakFixLab/fixstat." : {
      "localizations" : {
        "tr" : {
