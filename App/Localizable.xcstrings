    "Power-on hours" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalışma saati"
          }
        }
      }
    },
    "Press every key. A key turns blue once it registers; a key that stays grey did not respond. Hold fn for the top row, otherwise macOS uses those keys itself. Touch ID / power cannot be tested here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her tuşa basın. Algılanan tuş maviye döner; gri kalan tuş tepki vermemiştir. Üst sıra için fn'ye basılı tutun, yoksa macOS bu tuşları kendisi kullanır. Touch ID / güç düğmesi burada test edilemez."
          }
        }
      }
    },
    "Previous shutdown causes (last 30 days)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önceki kapanma nedenleri (son 30 gün)"
          }
        }
