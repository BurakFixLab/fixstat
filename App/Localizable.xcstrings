    "FixStat has no Bluetooth access. Allow it in System Settings › Privacy & Security › Bluetooth." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FixStat'ın Bluetooth erişimi yok. Sistem Ayarları › Gizlilik ve Güvenlik › Bluetooth'ta izin verin."
          }
        }
      }
    },
    "FixStat has no camera access. Allow it in System Settings › Privacy & Security › Camera." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FixStat'ın kamera erişimi yok. Sistem Ayarları › Gizlilik ve Güvenlik › Kamera'da izin verin."
          }
